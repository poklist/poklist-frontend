{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /*Shadcn*/
    // "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    // "allowImportingTsExtensions": true,
    // "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "composite": true,
    // Listing "types" disables TS's automatic @types/* discovery — only the
    // packages named here are pulled in. node/react are required explicitly
    // because process.env (Node) and JSX (React) are used throughout src/;
    // do not rely on vitest/@testing-library transitively re-exporting them.
    "types": ["vitest/globals", "node", "react", "react-dom"]
  },
  "include": ["src"]
}
