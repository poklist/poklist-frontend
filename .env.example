NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=

# Feature toggle（src/constants/features.ts）：只有 'true' 算開啟，未設定即關閉；改值要重新 build
# 上鎖名單：開啟時走新的 /creator/lists API
NEXT_PUBLIC_FEATURE_LIST_LOCK=false

# E2E 煙霧測試（選用；未設定時煙霧層自動 skip）
E2E_ACCESS_TOKEN=
E2E_SMOKE_BASE_URL=
E2E_SMOKE_USER_CODE=
E2E_SMOKE_LIST_ID=
